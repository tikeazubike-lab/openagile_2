{
 "name": "Package Purchase",
 "module": "Tutor Hub",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "is_submittable": 0,
 "autoname": "format:PKG-PUR-.#####",
 "fields": [
  {
   "fieldname": "package",
   "fieldtype": "Link",
   "label": "Package",
   "options": "Course Package",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "student",
   "fieldtype": "Link",
   "label": "Student",
   "options": "Student Profile",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "student_name",
   "fieldtype": "Data",
   "label": "Student Name",
   "fetch_from": "student.student_name",
   "read_only": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "tutor",
   "fieldtype": "Link",
   "label": "Tutor",
   "options": "Tutor Profile",
   "fetch_from": "package.tutor",
   "read_only": 1
  },
  {
   "fieldname": "purchase_date",
   "fieldtype": "Datetime",
   "label": "Purchase Date",
   "default": "Now",
   "read_only": 1
  },
  {
   "fieldname": "section_break_status",
   "fieldtype": "Section Break",
   "label": "Status"
  },
  {
   "fieldname": "amount_paid",
   "fieldtype": "Currency",
   "label": "Amount Paid",
   "reqd": 1
  },
  {
   "fieldname": "sessions_remaining",
   "fieldtype": "Int",
   "label": "Sessions Remaining",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "valid_until",
   "fieldtype": "Date",
   "label": "Valid Until"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Active\nCompleted\nExpired\nCancelled",
   "default": "Active",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "payment_transaction",
   "fieldtype": "Link",
   "label": "Payment Transaction",
   "options": "Payment Transaction"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Student",
   "read": 1
  }
 ]
}
